# ALICE (the desktop client) — copy to .env and fill in. Nothing here is read
# automatically; the entry points call load_dotenv() themselves. Values are read at
# import, so a change needs a restart. This is the CLIENT's env — the ledger server
# (app/server/) has its own, see server/.env.example. The client never talks to
# Postgres or Discord directly anymore (docs/todo.md Phase 2) — both moved server-side.
#
#   1. Required to run
#   2. Voice and overlay input
#   3. Tuning
#   4. Observability (optional)


# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED TO RUN
# ─────────────────────────────────────────────────────────────────────────────

# Which provider serves the chat model and the topic classifier.
# One of: ollama / openai / anthropic
LLM_PROVIDER=openai

# Fill in whichever provider you named above — the others can stay blank.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Ollama needs no key; it talks to a local server. Used by get_chat_llm() (app/llm.py)
# — respond's model. Reasoning measurably helps the 8B default here (evals/agent_eval/
# results/), which is why it defaults on -- but this is model-size-dependent, not a
# blanket "reasoning is good" result: 2026-09-29 runs showed gemma4:12b and gemma4:26b
# go from a noisy 56-67% pass rate with reasoning ON to a clean, repeatable 100% with
# it OFF on the same 9-case set, while 8B's pass rate drops without it. If
# OLLAMA_CHAT_MODEL ever moves off the 8B/e4b default, re-check this flag rather than
# assuming "on" is still right -- it was specifically right for 8B, not for bigger
# models in this family.
OLLAMA_CHAT_MODEL=gemma4
OLLAMA_REASONING=true

# Optional — get_classification_llm() (app/llm.py), used by classify_topic and the
# reject-voice line. Leave unset to fall back to OLLAMA_CHAT_MODEL (today's default,
# one model everywhere). Both are a fast binary decision / a short canned-shape line
# — cheaper/faster here while respond gets a bigger model is a real tradeoff worth
# trying, not a guess — but see docs/todo.md's agent_eval Phase 3 notes on running
# two models at once on a single machine: worth checking there's enough RAM/VRAM to
# hold both without one evicting the other between calls.
# OLLAMA_CLASSIFICATION_MODEL=gemma4

# Reasoning for the classification model above — defaults off (matches the fast/
# simple case classify_topic/reject actually need), unlike OLLAMA_REASONING above.
# Uncomment only if a future classification model is measurably shown to need it.
# OLLAMA_CLASSIFICATION_REASONING=false

# Live game-economy data. Both are needed — the bearer token authorises the
# requests, and every price, route and terminal lookup goes through it.
UEXCORP_API_KEY=
UEXCORP_BEARER_TOKEN=

# ALICE's voice. Without these she still thinks and still shows results in the
# overlay, but says nothing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Where the ledger server (app/server/) lives — the client never touches Postgres
# directly, it calls this over HTTP with the JWT from login (auth/discord_identity.py).
# Point this at a local `uvicorn server.main:app` for dev, or the real deployment
# (e.g. https://api.heyalice.help) for a real install.
ALICE_API_URL=http://localhost:8000


# ─────────────────────────────────────────────────────────────────────────────
# 2. VOICE AND OVERLAY INPUT
# ─────────────────────────────────────────────────────────────────────────────

# PTT_MODE=text falls back to typed input instead of the real hotkey/mic — useful on
# macOS until the running process (e.g. PyCharm) has Accessibility permission granted
# under System Settings > Privacy & Security > Accessibility. Not needed on Windows,
# where hotkey mode should work out of the box.
PTT_MODE=hotkey

# Hold to speak. Avoid a modifier you press while typing — shift_r is the default but
# it fires whenever you capitalise anything, which captures room noise mid-sentence.
PTT_HOTKEY=shift_r

# Toggles the trade-run overlay. pynput GlobalHotKeys format, e.g. <f3>, <ctrl>+<alt>+u
OVERLAY_HOTKEY=<f3>

# Where ALICE's one-time local listener catches the login redirect (auth/discord_
# identity.py) — the server bounces the browser back here once it's done its own
# Discord exchange. Change the port only if 8765 is already taken on your machine.
DISCORD_LOCAL_REDIRECT_URI=http://localhost:8765/callback


# ─────────────────────────────────────────────────────────────────────────────
# 3. TUNING
# ─────────────────────────────────────────────────────────────────────────────

# How many origin terminals one route search may fetch live from UEX. Anything already
# cached is searched for free on top of this, so a region search widens each time it's
# repeated. Raise it for better coverage per search, lower it if UEX rate-limits.
MAX_LIVE_ROUTE_FETCHES=8

# Fires one throwaway call through the persona and classifier models at startup, so
# Ollama's prompt-prefix cache is warm before the pilot's first real turn instead of
# during it. Measured 2026-09-22: the persona's tool-bound prompt (~9,700 tokens with
# every tool schema bound) cost ~30s of pure prompt-eval on a cold first call, dropping
# to well under a second on every call afterward that shares the same prefix. Only ever
# does anything when LLM_PROVIDER=ollama — hosted providers don't have this cold-start
# cost, so this is a no-op for them either way. Set to false to skip it (e.g. quick dev
# iteration where the first message being slow doesn't matter).
PREWARM_OLLAMA=true

# How much conversation each model call is sent (app/graph.py's _windowed_history). The
# full thread is still stored -- this only trims what goes to the model, so a long play
# session doesn't resend every earlier turn (and every old price list) on every turn.
# Counted in pilot turns. HISTORY_TURNS=0 sends the whole thread, the old behavior.
HISTORY_TURNS=6
# Of those, how many keep tool results in full; older ones are replaced with a short
# "call the tool again" stub. Minimum 1. 2 keeps follow-ups like "what about in Pyro?"
# working off the previous answer's results.
HISTORY_FULL_TOOL_RESULT_TURNS=2
# The topic classifier's own, smaller window -- it only judges the latest utterance.
CLASSIFY_HISTORY_TURNS=2

# Anthropic prompt caching (app/llm.py anthropic_cache_mode) -- ignored unless
# LLM_PROVIDER=anthropic. Every respond call starts with the same ~11.5k tokens (tool
# schemas + persona); cached, those bill at 0.1x input instead of 1x.
#   off    -- no caching
#   system -- cache tools + persona (the stable part; the recommended default)
#   full   -- also cache the conversation so far, so a turn's second call (after its
#             tools ran) reuses the first call's history too
# The classifier isn't cached: its prompt is below Haiku 4.5's 4,096-token minimum.
ANTHROPIC_CACHE_MODE=system
# How long a cache entry lives without being read: 5m (writes cost 1.25x) or 1h
# (writes cost 2x). 1h only pays off if turns are regularly 5+ minutes apart.
ANTHROPIC_CACHE_TTL=5m


# ─────────────────────────────────────────────────────────────────────────────
# 4. OBSERVABILITY (optional — ALICE runs fine with all of this blank)
# ─────────────────────────────────────────────────────────────────────────────

# LangSmith traces one run per user utterance, which is how you answer "why did she
# pick that tool". Aggregate health (is extraction degrading, what's the fallback
# rate) belongs on metrics instead — see docs/intent/observability.md.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Graphling"

# Fraction of traces actually sent (0.0-1.0). Billed per trace beyond the free tier,
# and volume scales with users — roughly $1.20/user/month at 1.0, which is more than
# the LLM costs. Leave at 1.0 while you're the only user; drop it well below that
# before anyone else is, and switch one client back to 1.0 to chase a reported bug.
LANGSMITH_TRACING_SAMPLING_RATE=1.0

# ─────────────────────────────────────────────────────────────────────────────
# NOT CURRENTLY USED
# ─────────────────────────────────────────────────────────────────────────────

# Embeddings went unused when the generic memory system was shelved (see CLAUDE.md).
# Kept rather than deleted because the compaction/memory work would need them again —
# nothing reads these today.
# OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
# OPENAI_EMBED_MODEL=text-embedding-3-small
