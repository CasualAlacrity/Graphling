# ALICE for a pilot: everything runs through ALICE's server, so there are no API keys
# here. scripts/windows/setup.bat (or scripts/mac/setup.sh) copies this to .env on first
# setup; edit .env, not this file. Developer settings live in .env-template.

# Where ALICE's server lives. Your Discord login happens through it on first launch.
ALICE_API_URL=https://api.heyalice.help
LLM_PROVIDER=alice
TTS_PROVIDER=alice

# Hold to talk. Avoid keys you also type with: right Shift fires whenever you capitalise.
PTT_MODE=hotkey
PTT_HOTKEY=shift_r
# Opens and closes the trade-run window.
OVERLAY_HOTKEY=<f3>

# Debug tracing is for development only.
LANGSMITH_TRACING=false
