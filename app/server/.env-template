# ALICE's ledger server — the additional env vars it needs, on top of whatever's
# already in the repo root's .env (server/config.py's Settings reads ".env" relative to
# CWD, same as every other module's load_dotenv() — in local dev, run both the server
# and the client from the repo root and these just join the same file as the client's
# own vars from .env-template). In production the server runs in its own container with
# its own filesystem, so these genuinely live in a separate file there (see
# docker-compose.prod.yml) — this file is that production shape, usable as a local
# .env too if you'd rather keep the two processes' config apart even in dev.

# Same asyncpg connection string the client used to use directly — read by
# db/session.py, unchanged. Points at whatever Postgres this server is the sole owner of.
TRADE_DB_URL=postgresql://graphling:graphling@localhost:5433/graphling

# From the Discord Developer Portal (discord.com/developers/applications) — the OAuth2
# tab. This server (not the client) now holds the secret, so set "Public Client" to
# OFF for this application before a secret is issued.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match exactly what's registered as a Redirect URI in the portal. This is the
# SERVER's own callback, not the client's local listener — e.g.
# https://api.heyalice.help/auth/discord/callback in production, or
# http://localhost:8000/auth/discord/callback for a local dev server.
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# UEX Corp — needed here now that the UEX cache's read-through-or-fetch logic moved
# server-side (uex_cache_service.py, docs/todo.md Phase 2's cache follow-up). Same
# values the client's own .env-template already asks for.
UEXCORP_API_KEY=
UEXCORP_BEARER_TOKEN=
